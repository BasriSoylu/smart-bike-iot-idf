        <mxCell id="byte0_bits" value="&lt;b&gt;Bit Düzeyi: 0x82 = 1000 0010&lt;/b&gt;" style="text;html=1;align=left;fontColor=#111;fontSize=14;fontStyle=1;" parent="1" vertex="1">
