        <mxCell id="byte0_box" value="&lt;b&gt;Byte 0&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;5&quot;&gt;0x82&lt;/font&gt;&lt;br&gt;Control Byte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="80" y="150" width="140" height="100" as="geometry" />
