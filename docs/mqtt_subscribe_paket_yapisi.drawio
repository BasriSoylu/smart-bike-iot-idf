        <mxCell id="section1_title" value="&lt;b&gt;1. FIXED HEADER&lt;/b&gt; — Her MQTT paketinde var" style="text;html=1;align=left;fontColor=#b85450;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="110" width="500" height="25" as="geometry" />
