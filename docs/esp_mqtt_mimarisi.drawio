    <mxCell id="sm_note" value="&lt;i&gt;mqtt_task sürekli döngüde:&lt;br&gt;1. State'e göre aksiyon al&lt;br&gt;2. TCP'den oku (select/recv)&lt;br&gt;3. Gelen paketi parse et&lt;br&gt;4. Event fire et&lt;/i&gt;" style="text;html=1;strokeColor=#82b366;fillColor=#f0fff0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;rounded=1;" vertex="1" parent="1">
