    <mxCell id="keepalive" value="&lt;b&gt;Keep-Alive Timer&lt;/b&gt;&lt;br&gt;─────────────────&lt;br&gt;esp_timer (SW timer).&lt;br&gt;&lt;br&gt;Her keepalive_ms'de&lt;br&gt;PINGREQ gönderir.&lt;br&gt;&lt;br&gt;PINGRESP gelmezse&lt;br&gt;→ disconnect tetikler." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
