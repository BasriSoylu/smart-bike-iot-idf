<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.0.9 Chrome/128.0.6613.186 Electron/32.2.5 Safari/537.36" version="26.0.9">
  <diagram name="Smart Bike IoT - Kod Mimarisi" id="0">
    <mxGraphModel dx="3187" dy="1876" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Smart Bike IoT — Kod Mimarisi (ESP32 + SIM800C)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="200" y="20" width="1800" height="44" as="geometry" />
        </mxCell>
        <mxCell id="gsm_hdr" value="📁 components / gsm / gsm.c" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="80" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="gsm_init" value="&lt;b&gt;gsm_init()&lt;/b&gt;&lt;hr/&gt;• UART2 yapılandır: GPIO16=RX, GPIO17=TX&lt;br/&gt;• uart_driver_install — RX buf 32 KB&lt;br/&gt;• AT → OK? → 115200 baud hazır&lt;br/&gt;• OK yoksa → 9600 baud dene&lt;br/&gt;• AT+IPR=115200 → hızı 115200&#39;e çek" style="rounded=1;fillColor=#f0fff0;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=10;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="169" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gsm_cmd" value="&lt;b&gt;gsm_send_command(cmd, response, timeout)&lt;/b&gt;&lt;hr/&gt;• uart_flush_input → RX buffer temizle&lt;br/&gt;• uart_write_bytes → komutu + \r\n gönder&lt;br/&gt;• uart_read_bytes → timeout ms bekle, cevap oku" style="rounded=1;fillColor=#f0fff0;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=10;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="318" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gsm_wait" value="&lt;b&gt;gsm_wait_response(expected, response, timeout)&lt;/b&gt;&lt;hr/&gt;• Döngü: timeout dolana kadar çalış&lt;br/&gt;• Her 500 ms&#39;de uart_read_bytes ile oku&lt;br/&gt;• strstr → beklenen string var mı?&lt;br/&gt;• Bulursa hemen dön, bulamazsa devam" style="rounded=1;fillColor=#f0fff0;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=10;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="448" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gsm_gprs" value="&lt;b&gt;gsm_gprs_connect()&lt;/b&gt;&lt;hr/&gt;• AT+CGATT=1 → GPRS&#39;e bağlan&lt;br/&gt;• AT+SAPBR=3,1,Contype,GPRS&lt;br/&gt;• AT+SAPBR=3,1,APN,internet&lt;br/&gt;• AT+SAPBR=1,1 → Bearer aç&lt;br/&gt;• AT+SAPBR=2,1 → IP sorgula&lt;br/&gt;• 0.0.0.0 gelirse → HATA döndür" style="rounded=1;fillColor=#f0fff0;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=10;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="588" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gsm_json" value="&lt;b&gt;gsm_http_get_json(url, buf, max)&lt;/b&gt;&lt;hr/&gt;• AT+HTTPTERM → önceki oturumu kapat&lt;br/&gt;• AT+HTTPINIT → HTTP stack başlat&lt;br/&gt;• AT+HTTPPARA=CID,1&lt;br/&gt;• AT+HTTPPARA=URL,&amp;lt;url&amp;gt;&lt;br/&gt;• AT+HTTPACTION=0 → GET isteği gönder&lt;br/&gt;• +HTTPACTION:0,200,&amp;lt;len&amp;gt; bekle (max 15s)&lt;br/&gt;• AT+HTTPREAD=0,&amp;lt;len&amp;gt; → veriyi oku&lt;br/&gt;• +HTTPREAD header parse et&lt;br/&gt;• AT+HTTPTERM → kapat" style="rounded=1;fillColor=#f0fff0;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=10;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="748" width="400" height="188" as="geometry" />
        </mxCell>
        <mxCell id="gsm_bin" value="&lt;b&gt;gsm_http_get_binary(url, offset, buf, size, ...)&lt;/b&gt;&lt;hr/&gt;&lt;i&gt;offset == 0 → ilk chunk, HTTP bağlantısını kur:&lt;/i&gt;&lt;br/&gt;• AT+HTTPTERM + 2s bekle&lt;br/&gt;• AT+HTTPINIT, AT+HTTPPARA URL&lt;br/&gt;• AT+HTTPACTION=0 → tüm dosyayı indir (max 90s)&lt;br/&gt;• +HTTPACTION:0,200,&amp;lt;total&amp;gt; → dosya boyutu al&lt;br/&gt;&lt;hr/&gt;&lt;i&gt;Her chunk için:&lt;/i&gt;&lt;br/&gt;• AT+HTTPREAD=&amp;lt;offset&amp;gt;,16384&lt;br/&gt;• +HTTPREAD header parse et&lt;br/&gt;• Binary veriyi out_buf&#39;a kopyala" style="rounded=1;fillColor=#f0fff0;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=10;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="976" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="eg1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="gsm_hdr" target="gsm_init" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eg2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="gsm_init" target="gsm_cmd" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eg3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="gsm_cmd" target="gsm_wait" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eg4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="gsm_wait" target="gsm_gprs" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eg5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="gsm_gprs" target="gsm_json" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eg6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="gsm_json" target="gsm_bin" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="main_hdr" value="📄 main.c — app_main()" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="560" y="80" width="320" height="48" as="geometry" />
