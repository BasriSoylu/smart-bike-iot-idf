        <mxCell id="srv_body" value="GET  /version.json  → versiyon bilgisi&#xa;GET  /firmware.bin  → binary firmware&#xa;POST /api/upload    → firmware yükle&#xa;────────────────────&#xa;Node.js + Express&#xa;PM2 (7/24 çalışır)&#xa;Nginx reverse proxy&#xa;Port 80" style="rounded=1;fillColor=#fff0f0;strokeColor=#b85450;strokeWidth=2;align=left;spacingLeft=12;fontSize=12;" parent="1" vertex="1">
