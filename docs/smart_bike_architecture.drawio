        </mxCell>
        <mxCell id="ota_hdr" value="📁 components / ota / ota.c" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1130" y="80" width="420" height="48" as="geometry" />
        </mxCell>
        <mxCell id="ota_parse" value="&lt;b&gt;parse_version(json, out, max)   [static — sadece ota.c içinde]&lt;/b&gt;&lt;hr/&gt;• JSON&#39;da &quot;version&quot; key&#39;ini bul&lt;br/&gt;• : ve &quot; karakterlerini atla&lt;br/&gt;• Değeri out buffer&#39;a kopyala&lt;br/&gt;• Örn: {&quot;version&quot;:&quot;V2.0&quot;} → &quot;V2.0&quot;" style="rounded=1;fillColor=#fff7e6;strokeColor=#d79b00;strokeWidth=2;align=left;spacingLeft=10;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1130" y="168" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ota_main" value="&lt;b&gt;ota_check_and_update()&lt;/b&gt;&lt;hr/&gt;1. gsm_http_get_json(version.json) → JSON al    &lt;font color=&#39;#82b366&#39;&gt;[gsm.c]&lt;/font&gt;&lt;br/&gt;2. parse_version() → server_version&lt;br/&gt;3. strcmp(server_version, FIRMWARE_VERSION)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Aynıysa → return 0 (güncelleme yok)&lt;br/&gt;&lt;hr/&gt;4. esp_ota_get_next_update_partition()&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ ota_0 veya ota_1 seç&lt;br/&gt;5. esp_ota_begin() → partition hazırla&lt;br/&gt;&lt;hr/&gt;6. DÖNGÜ: (toplam 10 iterasyon, 16 KB × 10 ≈ 152 KB)&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• gsm_http_get_binary() → 16 KB chunk al    &lt;font color=&#39;#82b366&#39;&gt;[gsm.c]&lt;/font&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• esp_ota_write() → flash&#39;a yaz&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• offset += chunk_len&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• offset &amp;gt;= total_len → çık&lt;br/&gt;&lt;hr/&gt;7. esp_ota_end() → firmware hash doğrula&lt;br/&gt;8. esp_ota_set_boot_partition() → boot güncelle&lt;br/&gt;9. esp_restart() → yeniden başlat" style="rounded=1;fillColor=#fff7e6;strokeColor=#d79b00;strokeWidth=2;align=left;spacingLeft=10;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1130" y="308" width="420" height="400" as="geometry" />
        </mxCell>
        <mxCell id="eo1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;" parent="1" source="ota_hdr" target="ota_parse" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eo2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;" parent="1" source="ota_parse" target="ota_main" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cfg_hdr" value="📁 components / config / config.h" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1690" y="80" width="340" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cfg_body" value="FIRMWARE_VERSION   &quot;1.0.0&quot;&#xa;OTA_VERSION_URL    /version.json&#xa;OTA_FIRMWARE_URL   /firmware.bin&#xa;──────────────────────&#xa;GSM_UART_PORT      UART_NUM_2&#xa;GSM_TX_PIN         GPIO 17&#xa;GSM_RX_PIN         GPIO 16&#xa;GSM_DEFAULT_BAUD   9600&#xa;GSM_TARGET_BAUD    115200" style="rounded=1;fillColor=#f5f0ff;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1690" y="168" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ecfg" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#9673a6;strokeWidth=2;" parent="1" source="cfg_hdr" target="cfg_body" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flash_hdr" value="💾 Flash Bellek — hafiza_listesi.csv" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1690" y="420" width="340" height="48" as="geometry" />
        </mxCell>
        <mxCell id="flash_body" value="nvs       0x9000     20 KB&#xa;otadata   0xe000      8 KB&#xa;ota_0     0x10000   1.5 MB  ← aktif fw&#xa;ota_1     0x190000  1.5 MB  ← yeni fw" style="rounded=1;fillColor=#fff0f0;strokeColor=#b85450;strokeWidth=2;align=left;spacingLeft=12;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1690" y="508" width="340" height="90" as="geometry" />
