        <mxCell id="srv_hdr" value="🌐 Hetzner VPS — boldmotorbikes.duckdns.org" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1690" y="640" width="340" height="48" as="geometry" />
