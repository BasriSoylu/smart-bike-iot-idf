          <mxGeometry x="560" y="380" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="④ while(1) — Normal çalışma döngüsü&lt;br/&gt;ESP_LOGI her 10 saniyede bir" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;html=1;" parent="1" vertex="1">
          <mxGeometry x="560" y="470" width="320" height="55" as="geometry" />
