          </mxGeometry>
        </mxCell>
        <mxCell id="edge-urc-binary" value="binary_takip_ediyor=true&#xa;(örn: +IPD,)" style="endArrow=classic;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;fontSize=10;fontStyle=2;strokeColor=#b85450;" parent="1" source="urc-table" target="handler-binary" edge="1">
          <mxGeometry x="-0.0909" y="-64" relative="1" as="geometry">
