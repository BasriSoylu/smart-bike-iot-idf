          <mxGeometry x="640" y="90" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reader" value="reader_task&#xa;(byte byte UART oku)&#xa;&#xa;switch(sim_rx_modu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="610" y="195" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="modu" value="sim_rx_modu = ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="630" y="320" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="process-line" value="process_line(line_buf)&#xa;&#xa;Satır biriktir (\r\n veya &#39;:&#39; a kadar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="290" y="460" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="urc-table" value="urc_tablosu[]&lt;br&gt;Prefix listesi taraması&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;{ &quot;&lt;b&gt;+IPD&lt;/b&gt;,&quot;&amp;nbsp; &amp;nbsp; &amp;nbsp;,         urc_ipd_isle&amp;nbsp; &amp;nbsp; &amp;nbsp;, true&amp;nbsp; }&lt;br&gt;{ &quot;&lt;b&gt;+HTTPREAD:&lt;/b&gt;&quot;,  urc_httpread_isle,  true&amp;nbsp; }&lt;br&gt;{ &quot;&lt;b&gt;+RECEIVE,&lt;/b&gt;&quot; ,    urc_receive_isle , true&amp;nbsp; }&lt;br&gt;{ &quot;&lt;b&gt;CONNECT OK&lt;/b&gt;&quot;,   urc_connect_ok&amp;nbsp; &amp;nbsp;,     false }&lt;br&gt;{ &quot;&lt;b&gt;NO CARRIER&lt;/b&gt;&quot;,   urc_no_carrier&amp;nbsp; &amp;nbsp;, false }&lt;br&gt;...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="199" y="570" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="handler-short" value="Handler çağrılır&#xa;(kısa AT cevabı)&#xa;&#xa;Örn: urc_connect_ok_isle()&#xa;urc_no_carrier_isle()&#xa;→ binary_takip_ediyor = false&#xa;→ İş bitti, devam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="-100" y="840" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="handler-binary" value="urc_ipd_isle() çağrılır&#xa;&#xa;sim_rx_kalan = 43&#xa;sim_rx_modu = TCP_BINARY&#xa;&#xa;binary_takip_ediyor = true&#xa;→ Mod değişti, sonraki bayt&#xa;   binary olarak işlenecek" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="374" y="840" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="binary-mode" value="TCP_BINARY MODU&#xa;&#xa;Her gelen baytı stream buffer&#39;a yaz:&#xa;xStreamBufferSend(sim_tcp_sb, &amp;byte, 1, 0)&#xa;&#xa;sim_rx_kalan--&#xa;sim_rx_kalan == 0 → modu LINE&#39;a döndür" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="870" y="460" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="stream-buffer" value="sim_tcp_sb&#xa;(FreeRTOS Stream Buffer, 2048 byte)&#xa;&#xa;Üretici: reader_task (yazar)&#xa;Tüketici: mqtt_receiver_task (okur)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;boundedLbl=1;backgroundOutline=1;size=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="900" y="620" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tcp-recv" value="sim800c_tcp_recv(buf, N, timeout)&#xa;&#xa;Döngü ile xStreamBufferReceive&#xa;Tam N byte birikene kadar bekle&#xa;veya timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="920" y="795" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mqtt-task" value="mqtt_receiver_task&#xa;(arka plan task)&#xa;&#xa;1) 1 byte control oku&#xa;2) 1 byte remaining_len oku&#xa;3) N byte payload oku&#xa;4) PUBLISH ise callback çağır" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="1240" y="775" width="140" height="120" as="geometry" />
        </mxCell>
