          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-sb-recv" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d79b00;" parent="1" source="stream-buffer" target="tcp-recv" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-recv-task" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" parent="1" source="tcp-recv" target="mqtt-task" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-task-callback" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" parent="1" source="mqtt-task" target="callback" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="LEGEND" style="text;html=1;align=center;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="100" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-uart" value="UART / I/O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="135" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-task" value="Task / Fonksiyon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="170" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-state" value="State / Karar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="205" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-binary" value="Binary mod / Veri" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="240" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-buffer" value="Buffer (kuyruk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="275" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend-mqtt" value="MQTT katmanı" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="310" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="example-title" value="ÖRNEK AKIŞ — &quot;hbs_smart_bike_2026_xyz123/komut&quot; topic&#39;ine gelen &#39;gaz_ac&#39; mesajı" style="text;html=1;align=center;fontSize=14;fontStyle=1;fontColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="270" y="1000" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="example-text" value="1. Broker → SIM800C: TCP üzerinden MQTT PUBLISH paketi (42 byte) gelir&#xa;2. SIM800C UART&#39;a yazar:  &quot;+IPD,42:0x30 0x28 0x00 0x20 &#39;h&#39; &#39;b&#39; &#39;s&#39; ... &#39;g&#39; &#39;a&#39; &#39;z&#39; &#39;_&#39; &#39;a&#39; &#39;c&#39;&quot;&#xa;3. reader_task LINE modunda → byte byte birikiyor → &#39;:&#39; karakteri görülünce process_line tetiklenir&#xa;4. process_line → urc_tablosu&#39;nda &quot;+IPD,&quot; prefix&#39;i eşleşir → urc_ipd_isle() çağrılır&#xa;5. urc_ipd_isle: sim_rx_kalan=42, sim_rx_modu=TCP_BINARY (binary_takip_ediyor=true → return)&#xa;6. Sonraki 42 bayt artık binary mod case&#39;ine girer → xStreamBufferSend ile sim_tcp_sb&#39;ye akar&#xa;7. mqtt_receiver_task xStreamBufferReceive ile bayt çeker → MQTT paketi parse eder&#xa;8. Control byte 0x30 (PUBLISH) → topic + payload ayrıştırılır → fp_message_callback çağrılır" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=15;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="190" y="1040" width="1050" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
