        <mxCell id="uart_h_content" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;#include &quot;uart_types.h&quot;&lt;br&gt;&lt;br&gt;uart_handle_t uart_baslat       (const uart_cfg_t *yapilandirma);&lt;br&gt;void          uart_durdur       (uart_handle_t tanitici);&lt;br&gt;&lt;br&gt;int           uart_gonder       (uart_handle_t tanitici,&lt;br&gt;                                  const uint8_t *veri,&lt;br&gt;                                  int uzunluk);&lt;br&gt;&lt;br&gt;int           uart_oku          (uart_handle_t tanitici,&lt;br&gt;                                  uint8_t *tampon,&lt;br&gt;                                  int maks_uzunluk,&lt;br&gt;                                  uint32_t zaman_asimi_ms);&lt;br&gt;&lt;br&gt;void          uart_temizle      (uart_handle_t tanitici);&lt;br&gt;void          uart_baud_degistir(uart_handle_t tanitici,&lt;br&gt;                                  int yeni_baud);&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
