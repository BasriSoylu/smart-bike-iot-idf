        <mxCell id="uart_types_content" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;typedef struct {&lt;br&gt;&amp;nbsp;uart_port_t           port_num;&lt;br&gt;&amp;nbsp;int                   tx_pin;&lt;br&gt;&amp;nbsp;int                   rx_pin;&lt;br&gt;&amp;nbsp;int                   baud_rate;&lt;br&gt;&amp;nbsp;int                   rx_buf_size;&lt;br&gt;&amp;nbsp;int                   tx_buf_size;&lt;br&gt;&amp;nbsp;uart_word_length_t    veri_bitleri;&lt;br&gt;&amp;nbsp;uart_parity_t         parity;&lt;br&gt;&amp;nbsp;uart_stop_bits_t      stop_bitleri;&lt;br&gt;&amp;nbsp;uart_hw_flowcontrol_t akis_kontrolu;&lt;br&gt;} uart_cfg_t;&lt;br&gt;&lt;br&gt;typedef uart_port_t uart_handle_t;&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
