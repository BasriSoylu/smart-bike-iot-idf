        <mxCell id="nt2b4anpcn0M_4nPq0Y0-1" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="450" y="-176" width="255" height="160" as="geometry" />
        </mxCell>
        <mxCell id="main_box" value="main.c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;" parent="nt2b4anpcn0M_4nPq0Y0-1" vertex="1">
          <mxGeometry width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="main_content" value="&lt;b&gt;&lt;font&gt;uart_cfg_t yapilandirma = {&lt;br&gt;  .port_num    = UART_NUM_2,&lt;br&gt;  .tx_pin      = 17,&lt;br&gt;  .rx_pin      = 16,&lt;br&gt;  .baud_rate   = 115200&lt;br&gt;};&lt;br&gt;&lt;br&gt;uart_handle_t tanitici = uart_baslat(&amp;amp;yapilandirma);&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;" parent="nt2b4anpcn0M_4nPq0Y0-1" vertex="1">
          <mxGeometry x="8" y="22" width="227" height="120" as="geometry" />
        </mxCell>
        <mxCell id="nt2b4anpcn0M_4nPq0Y0-2" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="850" y="-220" width="340" height="255" as="geometry" />
        </mxCell>
        <mxCell id="fCZ2ApCISgf3IPgpFfXO-2" value="" style="group" parent="nt2b4anpcn0M_4nPq0Y0-2" vertex="1" connectable="0">
          <mxGeometry width="340" height="254.99999999999997" as="geometry" />
        </mxCell>
        <mxCell id="sim800c_box" value="components/sim800c  (sonraki adım)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;verticalAlign=top;" parent="fCZ2ApCISgf3IPgpFfXO-2" vertex="1">
          <mxGeometry width="340" height="245" as="geometry" />
        </mxCell>
        <mxCell id="sim800c_content" value="&lt;b&gt;typedef int  (*write_fn_t)(void *ctx,&lt;br&gt;               const uint8_t *data, int len);&lt;br&gt;typedef int  (*read_fn_t) (void *ctx,&lt;br&gt;               uint8_t *buf, int len,&lt;br&gt;               uint32_t timeout_ms);&lt;br&gt;typedef void (*flush_fn_t)(void *ctx);&lt;br&gt;&lt;br&gt;typedef struct {&lt;br&gt;  write_fn_t  write;  // fonksiyon pointer&lt;br&gt;  read_fn_t   read;&amp;nbsp; &amp;nbsp;// fonksiyon pointer&lt;br&gt;  flush_fn_t  flush;  // fonksiyon pointer&lt;br&gt;  void       *ctx;    // uart handle buraya&lt;br&gt;} sim800c_handle_t;&lt;br&gt;&lt;br&gt;esp_err_t sim800c_init(sim800c_handle_t *dev);&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;" parent="fCZ2ApCISgf3IPgpFfXO-2" vertex="1">
          <mxGeometry x="8" y="22.25" width="324" height="206.54999999999998" as="geometry" />
        </mxCell>
        <mxCell id="nt2b4anpcn0M_4nPq0Y0-10" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="-60" y="-60" width="425" height="180" as="geometry" />
        </mxCell>
        <mxCell id="legend_box" value="Tasarım Prensipleri" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=top;container=0;" parent="nt2b4anpcn0M_4nPq0Y0-10" vertex="1">
          <mxGeometry width="425" height="180" as="geometry" />
        </mxCell>
        <mxCell id="legend_content" value="&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Courier New&quot;&gt;&lt;b&gt;✔ UART modülü SIM800C&#39;yi bilmez&lt;br&gt;✔ SIM800C uart.h&#39;ı include ETMEZ&lt;br&gt;✔ SIM800C pin/port bilmez&lt;br&gt;✔ Bağlama (wiring) sadece main.c&#39;de&lt;br&gt;✔ Fonksiyon pointer = interface / vtable&lt;br&gt;&lt;br&gt;Karşılaştırma (STM32 / OOP):&lt;br&gt;write_fn_t     ≈  sanal fonksiyon&lt;br&gt;sim800c.ctx    ≈  this pointer&lt;br&gt;uart_baslat()  ≈  HAL_UART_Init()&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;container=0;" parent="nt2b4anpcn0M_4nPq0Y0-10" vertex="1">
          <mxGeometry x="10" y="20" width="405" height="146" as="geometry" />
        </mxCell>
        <mxCell id="nt2b4anpcn0M_4nPq0Y0-11" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="-60" y="-230" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="nt2b4anpcn0M_4nPq0Y0-7" value="&lt;span style=&quot;text-align: left;&quot;&gt;Başlatma Akışı (main.c içinde):&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=top;container=0;" parent="nt2b4anpcn0M_4nPq0Y0-11" vertex="1">
          <mxGeometry width="425.1136363636364" height="160" as="geometry" />
        </mxCell>
        <mxCell id="flow_steps" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;1. uart_cfg_t yapilandirma = { port, pinler, baud }&lt;br&gt;2. uart_handle_t tanitici = uart_baslat(&amp;amp;yapilandirma)&lt;br&gt;3. sim800c_handle_t gsm = {&lt;br&gt;&amp;nbsp; &amp;nbsp; .yaz=_yaz, .oku=_oku,&lt;br&gt;&amp;nbsp; &amp;nbsp; .temizle=_temizle, .baglan=(void*)tanitici }&lt;br&gt;4. sim800c_baslat(&amp;amp;gsm)&lt;br&gt;5. sim800c_gprs_baglan(&amp;amp;gsm)&lt;br&gt;6. ota_kontrol_et(&amp;amp;gsm)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;container=0;" parent="nt2b4anpcn0M_4nPq0Y0-11" vertex="1">
          <mxGeometry x="19.545454545454547" y="22.15" width="410.45454545454544" height="123.85" as="geometry" />
        </mxCell>
        <mxCell id="nt2b4anpcn0M_4nPq0Y0-13" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 700; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 33px;&quot;&gt;UART Sub-Modül Mimarisi&lt;/font&gt;&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="548" y="-340" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="P3zYaeov4qYgkOuGW3Sw-1" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="525" y="502" width="590" height="165" as="geometry" />
        </mxCell>
        <mxCell id="uart_c" value="uart.c  —  İmplementasyon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;" parent="P3zYaeov4qYgkOuGW3Sw-1" vertex="1">
          <mxGeometry width="590" height="165" as="geometry" />
        </mxCell>
        <mxCell id="uart_c_content" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;uart_baslat()        → uart_param_config(), uart_set_pin(), uart_driver_install()&lt;br&gt;                          return yapilandirma-&amp;gt;port_num  (tanıtıcı = port numarası)&lt;br&gt;&lt;br&gt;uart_gonder()        → uart_write_bytes()&lt;br&gt;uart_oku()           → uart_read_bytes()&lt;br&gt;uart_temizle()       → uart_flush_input()&lt;br&gt;uart_durdur()        → uart_driver_delete()&lt;br&gt;uart_baud_degistir() → uart_set_baudrate()&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;" parent="P3zYaeov4qYgkOuGW3Sw-1" vertex="1">
          <mxGeometry x="5" y="22" width="578" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
