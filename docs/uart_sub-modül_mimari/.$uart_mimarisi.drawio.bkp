        <!-- sim800c → uart.h kullanır -->
        <mxCell id="arrow_sim_uart" value="uart_write / uart_read&#xa;uart_flush kullanır" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#333333;fontStyle=2;fontSize=11;dashed=1;" edge="1" parent="1" source="sim800c_box" target="uart_h">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== AÇIKLAMA KUTUSU ==================== -->
        <mxCell id="legend_box" value="Tasarım Prensipleri" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1120" y="340" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="legend_content" value="✔ UART modülü SIM800C'yi bilmez&#xa;✔ SIM800C UART pin/port bilmez&#xa;✔ Dependency Injection: handle verilir&#xa;✔ uart_handle_t = uart_port_t (ESP-IDF)&#xa;✔ Tek sorumluluk: her modül kendi işi&#xa;&#xa;Karşılaştırma (STM32):&#xa;uart_handle_t  ≈  UART_HandleTypeDef*&#xa;uart_init()    ≈  HAL_UART_Init()&#xa;uart_write()   ≈  HAL_UART_Transmit()" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1128" y="366" width="324" height="146" as="geometry" />
        </mxCell>

        <!-- ==================== AKIŞ OKLARI (renk açıklaması) ==================== -->
        <mxCell id="flow_title" value="Başlatma Akışı (main.c içinde):" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="310" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="flow_steps" value="1. uart_cfg_t cfg = { port, pins, baud }&#xa;2. uart_handle_t h = uart_init(&amp;cfg)&#xa;3. sim800c_init(&amp;gsm_dev, h)&#xa;4. sim800c_connect(&amp;gsm_dev)&#xa;5. ota_check(&amp;gsm_dev)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="80" y="345" width="280" height="100" as="geometry" />
        </mxCell>

