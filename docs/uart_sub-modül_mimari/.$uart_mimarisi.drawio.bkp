        <mxCell id="arrow_uartc_espidf" value="#include driver/uart.h" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;fontStyle=2;fontSize=11;" edge="1" parent="1" source="uart_c" target="espidf_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- uart.h → uart_types.h bağımlılığı -->
        <mxCell id="arrow_uarth_types" value="#include" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d6b656;fontColor=#d6b656;fontStyle=2;fontSize=11;" edge="1" parent="1" source="uart_h" target="uart_types">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- main.c → sim800c_init(handle) -->
        <mxCell id="arrow_main_sim" value="sim800c_init(dev, handle)&#xa;handle'ı verir" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;fontStyle=2;fontSize=11;dashed=1;" edge="1" parent="1" source="main_box" target="sim800c_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="148" />
              <mxPoint x="380" y="200" />
              <mxPoint x="1120" y="200" />
