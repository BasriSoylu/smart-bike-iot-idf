        <!-- ota → gsm -->
        <mxCell id="l4" value="gsm_http_get_json()&#xa;gsm_http_get_binary()" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#82b366;" edge="1" source="402" target="305" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- ota → flash -->
        <mxCell id="l5" value="esp_ota_write()" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;" edge="1" source="402" target="601" parent="1">
